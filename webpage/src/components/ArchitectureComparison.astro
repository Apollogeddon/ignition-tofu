---
const base = import.meta.env.BASE_URL;

const models = [
  {
    name: "Resources",
    tagline: "Manage configuration",
    description:
      "Declaratively define and manage Ignition resources including projects, connections, and security settings.",
    stats: [
      { label: "Stateful", value: "Yes" },
      { label: "Action", value: "CRUD" },
      { label: "Control", value: "Full" },
    ],
    features: ["Drift detection", "Version control", "Automated cleanup"],
    link: `${base}/docs/reference/resources/ignition_project/`,
    icon: `<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M13.85 22H18a2 2 0 0 0 2-2V8a2 2 0 0 0-.586-1.414l-4-4A2 2 0 0 0 14 2H6a2 2 0 0 0-2 2v6.6" /><path d="M14 2v5a1 1 0 0 0 1 1h5" /><path d="m3.305 19.53.923-.382" /><path d="m4.228 16.852-.924-.383" /><path d="m5.852 15.228-.383-.923" /><path d="m5.852 20.772-.383.924" /><path d="m8.148 15.228.383-.923" /><path d="m8.53 21.696-.382-.924" /><path d="m9.773 16.852.922-.383" /><path d="m9.773 19.148.922.383" /><circle cx="7" cy="18" r="3" /></svg>`,
  },
  {
    name: "Data sources",
    tagline: "Reference existing",
    description: "Fetch configuration from an existing Gateway to use as variables or inputs for other resources.",
    stats: [
      { label: "Stateful", value: "No" },
      { label: "Action", value: "Read" },
      { label: "Control", value: "None" },
    ],
    features: ["External referencing", "Safe lookup", "Zero impact"],
    link: `${base}/docs/reference/data-sources/ignition_project/`,
    icon: `<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z" /><path d="M14 2v5a1 1 0 0 0 1 1h5" /><circle cx="11.5" cy="14.5" r="2.5" /><path d="M13.3 16.3 15 18" /></svg>`,
  },
];
---

<section class="comparison-section">
  <div class="header">
    <h2>Choose your approach</h2>
    <p>Manage configuration as resources, or read existing settings as data sources.</p>
  </div>

  <div class="comparison-grid">
    {models.map(model => (
      <div class="model-card glass">
        <div class="model-header">
          <div class="icon-box" set:html={model.icon}></div>
          <div>
            <h3>{model.name}</h3>
            <p class="tag">{model.tagline}</p>
          </div>
        </div>
        
        <p class="desc">{model.description}</p>

        <div class="stats-grid">
          {model.stats.map(stat => (
            <div class="stat-item">
              <span class="stat-label">{stat.label}</span>
              <span class="stat-value">{stat.value}</span>
            </div>
          ))}
        </div>

        <ul class="features-list">
          {model.features.map(feature => (
            <li>
              <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              {feature}
            </li>
          ))}
        </ul>

        <a href={model.link} class="btn-more">
          Read the docs
          <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
        </a>
      </div>
    ))}
  </div>
</section>

<style>
  .comparison-section {
    padding: 4rem 1rem 8rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .header {
    text-align: center;
    margin-bottom: 4rem;
  }

  h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .header p {
    font-size: 1.25rem;
    color: var(--sl-color-gray-4);
  }

  .comparison-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2.5rem;
  }

  .model-card {
    padding: 2.5rem;
    border-radius: 24px;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    transition: border-color 0.2s;
  }

  .model-card:hover {
    border-color: rgba(var(--sl-color-accent-rgb), 0.3);
  }

  .model-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .icon-box {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    background: rgba(var(--sl-color-accent-rgb), 0.08);
    border: 1px solid rgba(var(--sl-color-accent-rgb), 0.25);
    color: var(--sl-color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
  }

  .icon-box :global(svg) {
    width: 24px;
    height: 24px;
  }

  h3 {
    font-size: 1.75rem;
    font-weight: 800;
    margin: 0;
  }

  .tag {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--sl-color-accent);
    margin: 0.25rem 0 0;
  }

  .desc {
    color: var(--sl-color-gray-3);
    line-height: 1.6;
    margin: 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    padding: 1.25rem;
    background: rgba(var(--sl-color-accent-rgb), 0.03);
    border-radius: 12px;
    border: 1px solid var(--sl-color-hairline);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--sl-color-text-muted);
    font-weight: 500;
  }

  .stat-value {
    font-weight: 700;
    color: var(--sl-color-text);
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .features-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--sl-color-text);
    font-size: 0.95rem;
  }

  .features-list li svg {
    color: var(--sl-color-accent);
  }

  .btn-more {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem;
    border-radius: 12px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-text);
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-more:hover {
    background: var(--sl-color-accent);
    color: var(--sl-color-text-invert);
    transform: translateY(-2px);
  }
</style>
