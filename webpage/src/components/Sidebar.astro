---
import { getCollection } from "astro:content";

const docs = await getCollection("docs");
const base = import.meta.env.BASE_URL;
const pathname = new URL(Astro.request.url).pathname;

// The reference is split as the provider registers it: its own configuration, then resources and data
// sources, each listed by type name (the group already says which kind it is)
const sections = [
  { label: "Guides", match: (id: string) => id.startsWith("guides/") },
  { label: "Provider", match: (id: string) => id === "reference" || id === "reference/index" },
  { label: "Resources", match: (id: string) => id.startsWith("reference/resources/") },
  { label: "Data sources", match: (id: string) => id.startsWith("reference/data-sources/") },
]
  .map((section) => ({
    ...section,
    items: docs
      .filter((d) => section.match(d.id))
      .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99) || a.data.title.localeCompare(b.data.title)),
  }))
  .filter((section) => section.items.length > 0);

const label = (title: string) => title.replace(/ (Resource|Data Source)$/, "");

/**
 * Checks if a doc link is currently active
 * Handles trailing slashes and base paths consistently
 */
const isActive = (id: string) => {
  const href = `${base}/docs/${id}/`.replace(/\/+/g, "/");
  const current = pathname.replace(/\/+/g, "/");
  return current === href || current === href.slice(0, -1);
};
---

<nav class="sidebar" aria-label="Documentation">
  {sections.map(section => (
    <div class="section">
      <h2 class="section-title">{section.label}</h2>
      <ul class="section-items">
        {section.items.map(item => (
          <li>
            <a 
              href={`${base}/docs/${item.id}/`} 
              class={`sidebar-link ${isActive(item.id) ? 'active' : ''}`}
              aria-current={isActive(item.id) ? 'page' : undefined}
            >
              {label(item.data.title)}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>

<style>
  .sidebar {
    padding-right: 1rem;
  }

  .section {
    margin-bottom: 2rem;
  }

  .section-title {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--sl-color-text-muted);
    margin-top: 1.33em;
    margin-bottom: 1rem;
    padding-left: 1rem;
  }

  .section-items {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-link {
    display: block;
    padding: 0.5rem 1rem;
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--sl-color-text-muted);
    border-radius: 6px;
    transition: all 0.2s;
  }

  .sidebar-link:hover {
    color: var(--sl-color-accent-text);
    background: var(--sl-color-accent-low);
  }
</style>
