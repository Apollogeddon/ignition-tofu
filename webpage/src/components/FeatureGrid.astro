---
const features = [
  {
    title: "Infrastructure as code",
    description:
      "Keep the gateway's projects, connections and settings in version control, alongside the rest of your infrastructure.",
    icon: `<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.15V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.706.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2h-3.35" /><path d="M14 2v5a1 1 0 0 0 1 1h5" /><path d="m5 16-3 3 3 3" /><path d="m9 22 3-3-3-3" /></svg>`,
  },
  {
    title: "Secure by design",
    description:
      "Secrets are encrypted in flight with Ignition's JWE encryption endpoints, so no plaintext passwords reach the API logs.",
    icon: `<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>`,
  },
  {
    title: "Drift detection",
    description:
      "Plans show changes made by hand in the Designer or the gateway web interface, and applying puts them back.",
    icon: `<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="18" r="3" /><circle cx="6" cy="6" r="3" /><path d="M13 6h3a2 2 0 0 1 2 2v7" /><path d="M11 18H8a2 2 0 0 1-2-2V9" /></svg>`,
  },
  {
    title: "Resource coverage",
    description:
      "Projects, database connections, devices, tag providers, identity providers, alarm journals, user sources and more.",
    icon: `<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M10 22V7a1 1 0 0 0-1-1H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5a1 1 0 0 0-1-1H2" /><rect x="14" y="2" width="8" height="8" rx="1" /></svg>`,
  },
  {
    title: "Enterprise ready",
    description:
      "Redundancy roles, Gateway Network connections, store and forward, and SMTP profiles for multi-gateway setups.",
    icon: `<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="16" y="16" width="6" height="6" rx="1" /><rect x="2" y="16" width="6" height="6" rx="1" /><rect x="9" y="2" width="6" height="6" rx="1" /><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3" /><path d="M12 12V8" /></svg>`,
  },
  {
    title: "Open source",
    description:
      "MIT licensed and built on the HashiCorp Plugin Framework, so adding a resource follows one well-trodden pattern.",
    icon: `<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="18" r="3" /><circle cx="6" cy="6" r="3" /><circle cx="18" cy="6" r="3" /><path d="M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9" /><path d="M12 12v3" /></svg>`,
  },
];
---

<section class="features-section">
  <p class="section-eyebrow">Features</p>
  <h2>Why use this provider?</h2>
  
  <div class="grid">
    {features.map(feature => (
      <div class="feature-card">
        <div class="icon-wrapper" set:html={feature.icon}></div>
        <h3>{feature.title}</h3>
        <p>{feature.description}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .features-section {
    box-sizing: border-box;
    max-width: var(--sl-content-width);
    margin: 0 auto;
    padding: 5rem 1.5rem;
    text-align: center;
  }

  h2 {
    margin: 0 auto 3rem;
    max-width: 22ch;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 1rem;
  }

  /* a flat card that lifts its border on hover */
  .feature-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 12px;
    background: var(--sl-color-surface);
    text-align: left;
    transition: border-color 0.15s;
  }

  .feature-card:hover {
    border-color: var(--sl-color-hairline-strong);
  }

  .icon-wrapper {
    display: flex;
    margin-bottom: 0.75rem;
    color: var(--sl-color-accent-text, var(--sl-color-accent));
  }

  .icon-wrapper :global(svg) {
    width: 20px;
    height: 20px;
  }

  h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--sl-color-text);
  }

  p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--sl-color-text-muted);
  }
</style>
